generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkMode {
  REMOTE
  HYBRID
  ON_SITE
}

enum ApplicationStatus {
  APPLIED
  INTERVIEWING
  OFFERED
  REJECTED
  STALLED
}

model Application {
  id           String            @id @default(cuid())
  companyName  String
  jobTitle     String
  url          String?
  salary       String?
  location     String?
  workMode     WorkMode
  status       ApplicationStatus
  contactName  String?
  contactEmail String?
  appliedAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  notes        String?           @db.Text
}

model GlobalSettings {
  id                  String @id @default(cuid())
  stalledThresholdDays Int    @default(14)
}
