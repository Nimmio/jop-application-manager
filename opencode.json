{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "architect": {
      "prompt": ".opencode/agents/architect.md",
      "model": "anthropic/claude-3-5-sonnet",
      "options": {
        "reasoningEffort": "high"
      }
    },
    "developer": {
      "prompt": ".opencode/agents/developer.md",
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "low"
      }
    },
    "tester": {
      "prompt": ".opencode/agents/tester.md",
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "medium"
      }
    },
    "git": {
      "prompt": ".opencode/agents/git.md",
      "model": "openai/gpt-5.6-luna",
      "options": {
        "reasoningEffort": "low"
      }
    }
  }
}
